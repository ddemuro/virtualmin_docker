# Virtualmin Docker Environment Configuration
# Copy this file to .env and update with your values

# Container Operation Mode
# Options: startlock (default), start, lock
OPERATION=startlock

# DKIM Configuration
# Your DKIM selector for mail signing
DKIMSELECTOR=default

# Mail Server Configuration
# Hostname for your mail server
VMINMAILNAME=mail.example.com

# LDAP Configuration
LDAP_ORGANISATION=Example Organization
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=changeme_ldap_admin_password

# SLAPD Password (for container LDAP)
SLAPD_PASSWORD=changeme_slapd_password

# MySQL/MariaDB Configuration
# Root password for MySQL/MariaDB
MYSQL_ROOT_PASSWORD=changeme_mysql_root_password

# Timezone Configuration
# Set your timezone (e.g., America/New_York, Europe/London, Asia/Tokyo)
TZ=UTC

# Network Configuration (optional)
# These are set in docker-compose.yml but can be overridden here
# NETWORK_SUBNET=172.16.235.0/24
# NETWORK_GATEWAY=172.16.235.1

# Resource Limits (optional)
# Uncomment and adjust as needed
# MEMORY_LIMIT=4g
# CPU_LIMIT=2

# Backup Configuration
# BACKUP_RETENTION_DAYS=7
# BACKUP_PATH=/data/backups

# Debug Mode (set to true for verbose logging)
DEBUG=false

# Monitoring Configuration
# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password

# Enable monitoring stack (set to false to disable)
ENABLE_MONITORING=true

# Metrics retention (days)
METRICS_RETENTION=30

# Logs retention (days)
LOGS_RETENTION=7